{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>datum-cloud/.github:renovate-config"
  ],
  "constraints": {
    "npm": "<12"
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "ui/packaging/dmg/**"
  ]
}
